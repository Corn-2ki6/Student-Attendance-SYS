* { font-family: "Segoe UI"; font-size: 14px; }
QWidget { background: #f5f7fb; color: #1f2937; }
QWidget#sidebar { background: #ffffff; border-right: 1px solid #e5e7eb; }
QLabel#logo { font-size: 25px; font-weight: 800; color: #111827; }
QLabel#sidebarSub, QLabel#miniUser, QLabel#headerUser, QLabel#muted { color: #6b7280; }
QLabel#pageTitle { font-size: 28px; font-weight: 750; }
QLabel#loginTitle { font-size: 29px; font-weight: 800; }
QLabel#sectionTitle, QLabel#dialogTitle { font-size: 19px; font-weight: 700; }
QLabel#statValue { font-size: 28px; font-weight: 750; }
QLabel#profileValue { font-weight: 600; }
QFrame#card, QFrame#loginCard { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; }
QPushButton { background: #ffffff; border: 1px solid #d1d5db; border-radius: 8px; padding: 10px 14px; }
QPushButton:hover { background: #f3f4f6; }
QPushButton#navButton { border: none; text-align: left; padding: 11px 12px; }
QPushButton#navButton:hover { background: #eef2ff; color: #1d4ed8; }
QPushButton#primaryButton { background: #2563eb; color: white; border: none; font-weight: 650; }
QPushButton#primaryButton:hover { background: #1d4ed8; }
QPushButton#logoutButton { color: #b91c1c; }
QLineEdit { background: white; border: 1px solid #d1d5db; border-radius: 8px; padding: 10px; }
QLineEdit:focus { border: 1px solid #2563eb; }
QTableWidget { background: white; border: 1px solid #e5e7eb; border-radius: 10px; gridline-color: #eef0f3; selection-background-color: #dbeafe; }
QTableWidget::item { padding: 7px; }
QHeaderView::section { background: #f3f4f6; border: none; border-bottom: 1px solid #e5e7eb; padding: 10px; font-weight: 650; }

QPushButton#linkButton {
    background: transparent;
    border: none;
    color: #2563eb;
    text-align: right;
    padding: 4px 2px;
    font-weight: 600;
}
QPushButton#linkButton:hover {
    color: #1d4ed8;
    text-decoration: underline;
}
